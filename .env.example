# Copy to .env.local.sh (export lines) for local runs. Render sets these from render.yaml.
DATABASE_URL=postgres://user:pass@localhost:5432/alpscrm
SESSION_SECRET=at-least-32-random-characters
SETUP_TOKEN=at-least-16-random-characters
BACKUP_TOKEN=at-least-32-random-characters
PUBLIC_APP_URL=http://localhost:3000
PORT=3000
# Optional
RESEND_API_KEY=
EMAIL_FROM=ALPS Consultancy <office@alpsconsultancy.co.uk>
EMAIL_REPLY_TO=office@alpsconsultancy.co.uk
INVITE_ORGANIZER_EMAIL=
COMPLYTRACK_URL=https://complytrack.alpsconsultancy.co.uk
DATABASE_SSL=false
